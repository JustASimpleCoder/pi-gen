IMG_NAME=watne_raspios_lite

# Architecture (Pi 5 requires 64-bit)
export ARCH='arm64'

# Target hostname
TARGET_HOSTNAME='watne'

# First user
FIRST_USER_NAME='keanu'
FIRST_USER_PASS='keanu'

# Enable SSH by default
ENABLE_SSH=1

# Locale settings
TIMEZONE_DEFAULT='America/Toronto'  # Change to your timezone
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
WPA_COUNTRY='ca'

# Skip stages 3, 4, 5 (desktop/full systems)
STAGE_LIST="stage0 stage1 stage2 stage-rt-kernel stage-navio2-realsense"

export RPI_MODEL=4
# Deployment directory
#DEPLOY_DIR='./deploy'

# Work directory (can be large - ensure enough disk space)
#WORK_DIR='./work'

# Enable compression for final image
DEPLOY_COMPRESSION='xz'

RELEASE='trixie'

echo "Pi-gen config loaded:"
echo "  Image: ${IMG_NAME}"
echo "  Arch: ${ARCH}"
echo "  Release: ${RELEASE}"
echo "  Stages: ${STAGE_LIST}"